# Copy to `.env` for local dev. Never commit `.env`.

# Admin operator gate — required on `/dashboard/admin/login` when set (server-only, no VITE_ prefix).
# Use single quotes if the value contains # or $ so dotenv-expand does not truncate or expand it.
# Prefer a long random string with letters, numbers, and - _ only.
ADMIN_OPERATOR_PASSCODE='your-operator-passcode-here'

# Supabase (client)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Supabase (server)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Magic link / site
# SITE_URL=https://your-domain.com
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# RESEND_NOTIFICATION_TO=

# Post-enquiry portal invite (~90–120s after form submit). Requires Supabase + Resend.
# POST_ENQUIRY_PORTAL_INVITE_DISABLE=true
# POST_ENQUIRY_PORTAL_INVITE_DELAY_MS=90000
