# Copy to `.env` for local dev. Never commit `.env`.

# Admin operator gate — required on `/dashboard/admin/login` when set (server-only, no VITE_ prefix).
# Use single quotes if the value contains # or $ so dotenv-expand does not truncate or expand it.
# Prefer a long random string with letters, numbers, and - _ only.
ADMIN_OPERATOR_PASSCODE='your-operator-passcode-here'

# Optional server-side rate limits (per serverless instance unless you add KV later)
# ENQUIRY_RATE_LIMIT_PER_WINDOW=6
# ENQUIRY_RATE_WINDOW_MS=900000
# MAGIC_LINK_RATE_LIMIT_PER_WINDOW=8
# PDF_RATE_LIMIT_PER_WINDOW=20
# API_RATE_LIMIT_DISABLE=true

# Review link token hashing pepper (recommended in production)
# REVIEW_TOKEN_PEPPER='long-random-string'

# Supabase (client)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Supabase (server)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Magic link / site
# SITE_URL=https://your-domain.com
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# RESEND_NOTIFICATION_TO=
# Resend test mode (`*@resend.dev`) only delivers to your account email. Gmail plus aliases
# (e.g. golfsolirl+logingolfsol@gmail.com) are routed to RESEND_NOTIFICATION_TO automatically.
# Production: verify golfsolirl.com at resend.com/domains and use e.g. info@golfsolirl.com.
# RESEND_TEST_DELIVERY_EMAIL=golfsolirl@gmail.com

# Post-enquiry portal invite (~90–120s after form submit). Requires Supabase + Resend.
# POST_ENQUIRY_PORTAL_INVITE_DISABLE=true
# POST_ENQUIRY_PORTAL_INVITE_DELAY_MS=90000
